<?xml version="1.0" encoding="utf-8"?>
<!--
  SECURITY: Data extraction rules for Android 12+ (API 31+)
  Disallows cloud backup and device-to-device transfer of app data
  to prevent session tokens and user data from being extracted.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
