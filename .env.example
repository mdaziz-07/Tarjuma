# ==============================================================================
# Tarjuma App — Environment Variables Template
# Copy this file to .env and fill in your project credentials.
# NOTE: Variables prefixed with VITE_ are exposed to the client bundle.
# All other variables remain strictly server-side / build-time only.
# ==============================================================================

# Supabase Backend Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare R2 Public CDN Endpoint (Public bucket delivering Quran audio)
VITE_R2_PUBLIC_URL=https://your-public-bucket.r2.dev

# Cloudflare R2 Management / S3 Credentials
# (Build-time / CI/CD scripts only — NEVER prefix with VITE_ to prevent frontend exposure)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
